{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.local/lbs-copilot/contracts/known_fact/v0.1.0",
  "title": "KnownFact",
  "$comment": "Purpose: a qualification fact already stored before this turn. Use case: InterpretationInput.known_facts. Example: {\"field\": \"region\", \"value\": \"India\", \"source\": \"state_store\"}.",
  "x-spec-version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["field", "value", "source"],
  "properties": {
    "field": {
      "type": "string",
      "enum": [
        "use_case_api",
        "region",
        "monthly_volume",
        "current_provider",
        "timeline",
        "budget",
        "technical_constraints",
        "decision_maker"
      ]
    },
    "value": {},
    "source": {
      "type": "string",
      "enum": ["state_store", "history"]
    }
  }
}
