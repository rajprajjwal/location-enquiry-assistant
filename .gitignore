# Purpose: keep local env, caches and secrets out of git.
# Use case: blocks keys/certs (e.g. *.crt, *.pem, .env, TRACKB_API_KEY) and the .venv/.
# Example: .venv/ and __pycache__/ below are never committed.

# Streamlit Cloud secrets with real values must never be committed.
# The placeholder .streamlit/secrets.toml (empty strings) is safe to track.
# If you fill in real values locally, rename it or add to .env instead.
.streamlit/secrets.toml
.venv/
/.venv
/.model-cache
__pycache__/
*.py[cod]
*.egg-info/
.Python
.DS_Store
.env
.env.*
*.key
*.pem
# vm07-ca.crt is a public CA certificate and IS committed to the repo.
# Other .crt files remain excluded.
*.crt
!vm07-ca.crt
*API_KEY*
*api_key*
TRACKB_API_KEY
# Generated scratch (reports and gold JSON are committed)
.pytest_cache/

# Rebuildable retrieval files.
copilot/rag/data/chroma/
copilot/rag/data/raw/

# Local review database.
copilot/case_storage/data/lbs.db*

copilot/model_gateway/assets/
# Allow the pinned Qwen3 tokenizer assets needed for LLM token counting.
# These are small public files (SHA-256 pinned in prepare_tokenizer.py).
!copilot/model_gateway/assets/
!copilot/model_gateway/assets/qwen3-8b/
!copilot/model_gateway/assets/qwen3-8b/tokenizer.json
!copilot/model_gateway/assets/qwen3-8b/tokenizer_config.json

# Local databases and rebuildable indexes inside verification snapshots.
copilot/**/results/**/*.db
copilot/**/results/**/*.db-*
copilot/**/results/**/data/chroma/

# Isolated baseline demo runtime files.
prompt-engineering-baseline/*.db*
prompt-engineering-baseline/*.log
prompt-engineering-baseline/data/kb_index/
prompt-engineering-baseline/data/bm25_index.pkl

# Downloaded model cache.
.model-cache/

# Private tracing configuration and local run databases.
copilot/observability/runtime/

# Local trace databases; JSON evidence is versioned.
results/observability/**/*.db*

# Isolated evaluation case state; portable scores and predictions stay versioned.
results/evaluation/**/*.db*
results/evaluation/**/inflight.json

results/evaluation/**/.run.lock
results/evaluation/**/*.tmp

# Local package build output.
/build/
